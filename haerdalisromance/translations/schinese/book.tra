@0 = ~（海尔达利为你写的书此刻正静卧于你手中。）~
@1 = ~（翻开书的第一页。）~
@2 = ~（翻阅书籍的前半部分。）~
@3 = ~（翻阅书籍的后半部分。）~
@4 = ~（浏览海尔达利之前建议的那些章节。）~
@5 = ~（在书中搜寻你与这位吟游诗人之间那些更为亲密的时刻。）~
@6 = ~（随意地翻动书页。）~
@7 = ~（毁掉这本书。）~
@8 = ~（把书收起来。）~
@9 = ~“这些书页，是为向我心爱的渡鸦——来自烛堡的<CHARNAME>——致敬而写。在她身边，我游历了遥远的土地，见证了无数骇人听闻又蔚为壮观的奇事，并在每一个转折点与凶残狡诈的敌人战斗。最重要的是，她将她的心交给了我，正如她用一瞥一笑就偷走了我的心一样。谢谢你，<CHARNAME>，我的渡鸦，我的缪斯，我美丽的半神，感谢你允许我这样一位卑微的吟游诗人在你的传奇中扮演一个角色。”~
@10 = ~“这些书页，是为向烛堡的<CHARNAME>致敬而写。在她身边，我游历了遥远的土地，见证了无数骇人听闻又蔚为壮观的奇事，并在每一个转折点与凶残狡诈的敌人战斗。谢谢你，<CHARNAME>，感谢你允许我这样一位卑微的吟游诗人在你的传奇中扮演一个角色。”~
@11 = ~“尽管她的出生地不为人知，但<CHARNAME>是在烛堡那座壁垒森严的图书馆中被抚养长大的，那里俯瞰着剑湾一处孤寂海岸外的宝剑海。被难以想象的浩瀚知识与智慧所包围，这个女孩在秘密中被抚养长大，远离尘世的危险。或者，也许是这世界得以远离她的威胁。”~
@12 = ~“我们女主角的养父是一位名叫葛立安的男子。作为一位成就卓著的法师和受人尊敬的竖琴手，葛立安非常认真地履行着对他监护对象的责任。然而，保护一个神子的代价，远比他所能想象的更为巨大。”~
@13 = ~“<CHARNAME>在她的旅途中遇见并与许多奇特迷人的人物结伴同行，尽管这些人的动机并非总是清晰。无论他们各自的欲望为何，这些勇敢的男男女女，一次又一次地为了一位他们几乎不了解的年轻女子而将生命置于险境。”~
@14 = ~“一个宛如怪物的男人，身披冷钢与最深邃的阴影，挡住了他们的去路。葛立安的脸色在月光下显得苍白，他挡在这位魁梧的战士和他的被监护人之间，呼唤魔法来保护自己和女孩。”~
@15 = ~“爱蒙的手颤抖着靠近<CHARNAME>。这个爱笑的粉发女孩，在她那晚选择跟随葛立安离开烛堡时，永远无法想象她将从森林的阴影中目睹何等恐怖。她无法将那些景象从脑海中抹去。当那位竖琴手法师倒在沙洛佛克的剑下时，年轻的爱蒙心中一部分的天真也随之死去了。”~
@16 = ~“天生领袖的最佳标志，就是能够凝聚一个尽管存在分歧的团队。虽然紧张气氛有时会升温沸腾，但<CHARNAME>无数次证明，她有能力引导哪怕是最爱争吵、最令人不快的个体走向共同的目标。”~
@17 = ~“这座熙熙攘攘城市的景象、声音和气息，对我们年轻的女主角来说既陌生又奇特。她近乎与世隔绝地长大，高耸的建筑和市场上涌动的人潮，对<CHARNAME>而言完全是新事物。”~
@18 = ~“巴尔之子。这几个字如此简单，却又如此意味深长且同样致命。她身世的真相，如同一口巨钟在她耳边敲响，震惊、麻木、完全超现实。这对她意味着什么？”~
@19 = ~“沙洛佛克以他父亲血脉赋予的所有力量与狂怒战斗。他毫无保留，并要求<CHARNAME>同样付出一切。她能在这场残酷的战斗中幸存吗？她能召唤出力量，为养父之死复仇，并夺回自己的生活吗？”~
@20 = ~“<CHARNAME>很早就明白，只要花时间去寻找，总有工作可做。很多时候，她甚至根本不需要费那么多事。工作自己就会找上门来。她偶尔会想，在她到来提供帮助之前，这些国度究竟是怎么运转的。”~
@21 = ~“当<CHARNAME>最初踏上旅程时，她无法知道这条路将带她走多远。一步又一步，将她引向巨大的城市、高耸的雪山之巅、黑暗不祥的洞穴，以及其他许多难以想象的地方。在迈出第一步时她唯一能确定的，就是她在烛堡拥有的宁静生活已经一去不复返了。”~
@22 = ~“暗杀企图会让人变得多疑，<CHARNAME>不得不时刻提防伏击，即使在最安全的地方也要搜索阴影。为何她一夜之间从一个单纯的孤女变成了被悬赏追捕的目标，这是一个谜。显然，她的身世比葛立安所解释的更为复杂。”~
@23 = ~“对<CHARNAME>而言，沙洛佛克是一个怪物，一个凶手，一个追踪并逼迫她每一步行动的人。但并非所有人都这么看他。他激发了爱他之人令人惊讶的忠诚与奉献，这或许证明了，这个人远非简单的恶棍。”~
@24 = ~“在最初露宿荒野的某个夜晚，<CHARNAME>学到了在开阔地带休息的危险。袭击者从四面八方涌来，虽然他们被相当轻松地击退，但对这位年轻的冒险者来说，这是宝贵的一课。她再也不会在深夜毫无防备地被抓住了。”~
@25 = ~“得知自己身世的真相，什么都没有改变，却又改变了一切。他们都用不同的眼光看她，尽管她仍是两周前他们认识的那个年轻女子。他们听从她的命令，但有时反应会慢一些。这些小事不断提醒着她，作为一个巴尔之子，她永远不会被完全接纳。”~
@26 = ~“她在冰冷的黑暗中醒来，四肢残留着几乎被遗忘的痛楚。爱蒙站在她身旁，脸色苍白、肮脏，带着旧泪的痕迹。溃烂死亡的恶臭，令人窒息而沉重，充满了这间巨大的囚室。手掌下的石头冰冷、污秽、湿滑。无论这是什么噩梦，<CHARNAME>都无法从中醒来。”~
@27 = ~“魔法在空中嗡嗡作响，呈现出<CHARNAME>前所未见的炫目景象。她之前的俘获者和折磨者击溃了对抗他的法师们，他们倒下的躯体加入了早已堆在他脚边那些穿着皮甲的尸体中。他似乎已胜券在握，因为无人能与他抗衡。刹那间，一切改变了。”~
@28 = ~“无助且难以置信，<CHARNAME>只能眼睁睁看着爱蒙在她眼前尖叫着消失。”~
@29 = ~“这个盗贼是个狡猾的人，他态度坦率，笑容旨在消除任何认为他可能构成威胁的想法。<CHARNAME>无法信任他，也无法承担信任任何人的代价，但他甜蜜的言辞和含糊的承诺中提到了两个她无法假装忽略的名字。如果这个人有能力兑现他声称的事情，那么问题就变成了：她能承担不信任他的代价吗？”~
@30 = ~“<CHARNAME>在她漫长曲折的旅途中面临过许多艰难抉择，但决定将信任托付给两个不可靠团体中的哪一个，可能是最困难的。双方都以背信弃义闻名，并在他们自己的私人战争里于街头肆意残杀对方。在完美的世界里，<CHARNAME>或许会与两者告别，另辟蹊径。但这个世界从来都远非完美。”~
@31 = ~“甩开脑中那强大法术残留的混沌迷雾，这位囚犯仔细打量着他昏暗的周遭。模糊的记忆片段般闪现——一颗宝石、一条下水道、一个法师……还有一个错误。一个愚蠢的举动，他害了所有人。”~
@32 = ~“但是，如果他现在自由了，那一定发生了什么变化。这位位面行者用不稳的双腿支撑着从地板上站起，出发去探寻这个新谜团的真相。”~
@33 = ~“尽管她已经救过他一次，但海尔达利并不认为这个女人比任何其他<PRO_RACE>更出众。毕竟，她只是个主位面生物。但是，当她冲进那地狱般监狱的牢房，脸上带着坚定的决心，捕获者的鲜血仍新鲜地沾在她身上时，这位吟游诗人的看法开始改变了。”~
@34 = ~“他几乎无法想象，这个女人将如何深刻地影响他不久的未来。”~
@35 = ~“<CHARNAME>发现自己所在的这个安姆国度，与剑湾截然不同。这里由法师统治，他们利用自己的影响力与权力，通过恐惧和迷信迫使民众屈从。在此地，成为一位奥术施法者就是使自己成为靶子。”~
@36 = ~“冒险者的生活远不如某些故事所描绘的那般光鲜浪漫。这些浪漫故事很少提及在拥挤的街道下长途跋涉，在齐膝深的污秽与废物中蹚行数小时。大多数人一生都不会看到下水道内部，而<CHARNAME>却靠探索它们来谋生。”~
@37 = ~“借用主位面的一句谚语，这个人类的笑容滑溜得像条涂了油的鳗鱼。西蒙·哈瓦里安是那种在任何情况下都不能信任的人，无论别人对他有多大影响力。这位水手很快就证明了这一点。”~
@38 = ~“布林罗被证明是个真正独特的地方。海盗和妓女充斥街道，他们的叫喊与争吵混入咸涩的海风中，与头顶海鸥愤怒的啼鸣交织。这不是一个人想被困住的最佳地点，而这正是<CHARNAME>发现自己所处的困境。”~
@39 = ~“禁魔监狱的墙壁令人窒息，角度全都透着诡异。光线昏暗，忽明忽灭。空气中弥漫着某种压抑的东西，它扼杀了魔网，将魔法从被囚禁者的手中夺走。这比简单的牢笼更糟。这是一个希望死去的地方。无处可逃。”~
@40 = ~“黑暗吞噬了他，片刻后他醒来，头痛欲裂。她不见了，他的<CHARNAME>，在一阵迷失方向的恐慌中，他被恐惧攫住了。艾瑞尼卡斯在对她做什么？他一次，两次地猛撞铁栏……接着空气中传来远处的尖叫声，让他血液冰冷。”~
@41 = ~“她不是那种会尖叫的女人。她会吼叫，会大喊，偶尔甚至会呼喊，但这回荡在他耳边无休无止、充满恐惧的刺耳尖啸，是他从未从她那里听到过的。这声音令人恐惧，但当尖叫声戛然而止，空寂的走廊再次被沉默填满时，他的恐惧加倍了。”~
@42 = ~“愤怒以从未有过的方式淹没了她。没有灵魂来阻止这股洪流，<CHARNAME>被卷入体内那愤怒与憎恨的潮汐之中。狂野且无法控制，这些情绪涌上表面，如同爪子般从内向外撕扯着她的血肉。”~
@43 = ~“他在房间的另一边为性命搏斗，并未察觉到他所爱的渡鸦的挣扎，直到一声野兽般的咆哮充斥空气，吓得攻击的吸血鬼们畏缩后退。他转身寻找源头，却面对着一个比他多年来在任何位面见过的任何生物都更可怕的怪物。确信即将发生的事，他立刻转身，以最快的速度逃离了战场。”~
@44 = ~“经过数英里的追踪、浪费数千枚金币、饱受折磨的梦境、不断的挑衅，以及两个灵魂的失去，<CHARNAME>比任何时候都更渴望终结琼·艾瑞尼卡斯。当面对愤怒的渡鸦时，这位法师做了什么？他逃跑了。那男人瞬间从战斗中消失，留下一个没有灵魂的神子别无选择，只能追猎他。”~
@45 = ~“幽暗地域这个名字恰如其分，因为在大多数时候，黑暗几乎是唯一可见之物。这是个危险的地方，比主位面的地表更甚，在许多方面与几个不那么宜人的位面相似。”~
@46 = ~“在此情形下，几乎没有时间欣赏风景。没有了灵魂作为锚点，<CHARNAME>已不再是她自己。他们耽搁得越久，她就越可能再也无法恢复自我。”~
@47 = ~“艾瑞尼卡斯并非人类法师。聚集的精灵们不情愿地透露，事实上他曾是他们的一员，他的灵魂因很久以前犯下的罪行而被剥离作为惩罚。他没有得到应得的死亡，相反，琼·艾瑞尼卡斯被释放到国度中，没有灵魂赋予他良知。”~
@48 = ~“芭荻在尖叫中死去，喷吐着胆汁、憎恨和她所有自以为应得的权利。当<CHARNAME>转身离开她的巢穴时，这个曾将许多生命玩弄于股掌之中的傲慢吸血鬼，除了一堆崩解的尘埃外，什么也没剩下。”~
@49 = ~“宏伟的精灵城市索丹尼斯拉高高矗立，美丽而桀骜，尽管战争正将它撕成碎片。艾瑞尼卡斯向他曾经的同胞释放了难以言说的怪物军团，让他们面前的道路铺满了尸体。<CHARNAME>扬起下巴，挺直背脊，坚定地开始向阻挡她夺回本属于她的灵魂的敌人发起冲锋。”~
@50 = ~“这是最糟糕的时机，但他不能再等了。他们可能转瞬即逝，哪个心智正常的人会愿意带着遗憾进坟墓？将谨慎抛诸脑后，海尔达利抓住<CHARNAME>的手臂，将她扭转身来面对自己。告白愚蠢地卡在他的喉咙里，但片刻之后，话语还是滑了出来。”~
@51 = ~“这个曾是<CHARNAME>最大敌人的男人，看起来并没有应有的那么可怕。也许是因为他已经死了，不过是一个曾经可怕之人的苍白倒影。他的绝望对任何有眼睛的人来说都显而易见，因为他所滞留的状态并不愉快，但他所掌握信息的价值也同样明显。”~
@52 = ~“他留给<CHARNAME>的选择寥寥无几，只能再次赋予他生命。”~
@53 = ~“<CHARNAME>所占据的那一小片位面空间，确实是个奇妙的东西。它能响应她的指令，能按她的意志塑形，但其中某些部分在时机成熟前却无法触及。她在这些口袋中的口袋里面对考验，这些试炼为某种神秘目的而设计。每一次胜利，渡鸦的力量都在增长。”~
@54 = ~“一个口吐谎言、眼神闪烁的女人，在饱受战争蹂躏的街道上迎接<CHARNAME>。这个梅丽珊自称是巴尔之子们的朋友，这在<CHARNAME>整个旅途中是从未有过的说法。无论这个女人真实身份是什么，她都绝非朋友。”~
@55 = ~“战争的终结与熵的必然性，在萨拉都什的废墟中被找到。浓烟升入冷漠无情的天空，即使小雨开始飘落，余烬仍顽固地拒绝熄灭。死亡今日已饱餐。这仅仅是对巴尔之子所行之路的短暂提醒。”~
@56 = ~“赏金猎人们跨越广阔的开阔沙漠追踪<CHARNAME>的足迹，她项上人头的赏金值得他们冒着酷热死亡的威胁。尽管他们的陷阱失败了，但他们的突然出现，提醒着一段<CHARNAME>更年轻、更天真时的岁月，那时第一批刺客开始追杀她。或许，这预示着一切终将轮回。”~
@57 = ~“梅丽珊指引<CHARNAME>去见的巴萨扎，是个古怪的人。他守着自己的秘密，似乎以此为掩护，他的行为举止充满了罪恶感。无论他在这场戏中最终扮演什么角色，他的立场都不容忽视。”~
@58 = ~（海尔达利在几个章节的末尾写下了简短的私人笔记。其中一条吸引了你的目光。）~
@59 = ~“在我生命的岁月里，我见过许多美丽的女子。我见过所有体型、身材、肤色、种族和混血种族。我曾与之同床共枕的人数多到我无法记清，许多面孔已永远地从我记忆中褪色。我曾许下承诺与誓言，却又未能信守。”~
@60 = ~“那么，当我宣称<CHARNAME>是一张我永不会忘记的面孔时，谁又能确信我所说的是真话？我如何能断言她在所有人中闪耀着光芒，甚至比我曾见过的最姣好的面容更美丽？她若不相信我这演员的巧舌，才是明智之举，然而……我承认，我希望她在此事上是愚蠢的。”~
@61 = ~“几天前买下这本漂亮的皮面书时，我没想到它的书页会填得这么快。<CHARNAME>正被证明是一个无比诱人且迷人的主题。我发现自己很庆幸曾愚蠢到被捕获两次，而非一次，否则我根本不会置身于她美好的陪伴之中。”~
@62 = ~（某一章中的简短段落吸引了你的目光。）~
@63 = ~“他们在生命中目睹了太多死亡，无论是一起还是在他们的人生轨迹交叉之前。对她而言，他可能似乎对这一切都无动于衷，或者他在混乱与毁灭中寻得的欢愉，与聆听一位才华横溢的吟游诗人或与好友共饮一杯时感受到的欢愉并无二致。”~
@64 = ~“但有一些时刻……当她转过脸去隐藏痛苦，但她那原始、愤怒的情感边缘仍会闪现一瞥的瞬间。在那些时刻，他如此迫切地希望自己能坦白自己的挣扎，但她已经背负了太多，他拒绝将自己的重量加诸其上。”~
@65 = ~“看着我的渡鸦，当她未察觉我在注视时，那是我最钟爱的乐趣之一。或许这是个奇怪的坦白，但在那些毫无防备的时刻，她并非同一个女人。领袖的面具悄然滑落，她的眼中闪烁着年轻的好奇，有时也流露出内心的挣扎与疲惫。当我看到她这个样子时，她是如此美丽。”~
@66 = ~“但如果我把这些想法告诉她，我担心那些时刻将会消失，那将是莫大的遗憾。”~
@67 = ~“我在想，我的渡鸦的饮酒习惯是否会令其他主位面居民感兴趣。至少，她醉酒后的举止，很可能会像给我带来乐趣一样，让他们也觉得有趣，对吧？”~
@68 = ~“她发出一声窒息的叫喊醒来，惊动了附近试图休息的人。只需看一眼她的脸，便能确认她痛苦的原因。”~
@69 = ~“当变化最初降临到她身上时，是在激战与挫败的紧要关头，瞬间扭曲了她，没有时间让她意识到发生了什么。这一次却如此不同。”~
@70 = ~“她抵抗着，背脊弓起，双手在身侧紧握成不可思议的拳头。手臂上的皮肤隆起、裂开，从渗血的裂隙中长出长长的尖刺。她的皮肉条条剥落，为下方形成的坚硬乌木板甲让路。”~
@71 = ~“即使他向后急退，明知现在就该逃跑，他仍无法将视线从她身上移开。他永远不会忘记在她双眼圆睁时看到的恐惧与绝望，就在变化将那表情从她脸上撕裂，取而代之的只有原始饥饿之前。”~
@72 = ~“冬寒迅速降临，驱走了这片土地上的生机。几株坚韧的花朵点缀路边，抗拒离去，无视自然的指令，紧紧抓住生命。<CHARNAME>驻足片刻，久久凝视它们。一抹最细微的笑意牵动她的嘴角，随后她继续前行。”~
@73 = ~“夏日的炎热带来了紧张和易怒的脾气。<CHARNAME>常被置于调解同伴之间纷争的位置，但即使是这位看似肩负世界重量的她，也缺乏耐心。如果今天仅仅是恶语相向，那将是奇迹。”~
@74 = ~“春雨为这片土地带来生机与复苏，但也为旅行的冒险者增添了令人不快的烦恼。腐烂的皮革和生锈的铠甲，与覆盖周围山丘的鲜艳花朵形成了鲜明对比。<CHARNAME>被迫花费更多辛苦赚来的金币来弥补这些损失。”~
@75 = ~“今年的秋天令人愉悦。随着树木褪去夏日的绿装，动物们为即将到来的雪季忙碌准备，<CHARNAME>和她的同伴们怀着更佳的心绪继续旅程，这在很大程度上得益于更凉爽温和的天气。她展露笑颜的时候比不久前更多了。也许，除了天气，还有其他原因导致了这一变化。”~
@76 = ~“那天旅行时，他捕捉到她在注视他，但他读不懂她的表情，无法知晓她的想法。当他们停下扎营过夜时，他再次感觉到她的目光落在他身上，但当他转身时，她却移开了视线。当他缓步走向附近的河流，洗去路途的尘埃时，他心底某处希望她会跟来，即使她不会让他知道她在注视。”~
@77 = ~“那天夜里在篝火旁，他为她歌唱，一首关于芜菁的简短而愚蠢的歌，得到的回报是欢快的笑声。这声音本身并无特别神奇或悦耳之处，但看到<CHARNAME>发笑并知道自己是这笑声的起因，在他胸中点燃了一簇陌生的火花。只要能再次听到那笑声从她唇边传出，他甘愿为她扮演小丑。”~
@78 = ~“当我坐在这家令人不快的旅店后角安静的桌边时，我不得不克制自己不去注视我的渡鸦，同时写下这些笔记。她正与其他人交谈，但她有些心不在焉，目光扫视着房间。当她看到我时，她微笑着走来。她递给我一杯酒，紧挨着我坐下。桌下，她的大腿温暖而持续地贴着我的。她知道当她如此靠近时，我的心跳得有多快吗？”~
@79 = ~“她完全不知道自己有多迷人。此刻我看着她小口吃着主位面的某种水果，名字我记不清了。果汁从她嘴角滑落，在她下巴留下一道诱人黏腻的痕迹，我为此完全分神了。”~
@80 = ~“照这样下去，我永远写不出什么有价值的东西了。”~
@81 = ~“<CHARNAME>有最美丽的腿。她肯定知道这点。我们所有的徒步行走将它们塑造成了如此有力且匀称的形状。把它们遮起来简直是犯罪。”~
@82 = ~“她昨晚找到了一双新靴子。它们丑陋、不成形、厚得像迷诱魔的屁股，与任何其他同龄女性可能喜欢的款式完全相反。这就是冒险者生涯如何塑造我们的观念和优先级的奇特之处。”~
@83 = ~“初次亲吻，我的唇贴着她的，在彼此的激情中锁在一起。她尝起来像命运的味道，于我舌间是蜜糖与灰烬。”~
@84 = ~“她的手缠绕在他的发间，带着急促的粗鲁命令他靠近，双唇因期待而分开。她的眼神诉说着饥渴与渴望，但同样不变的悲伤也萦绕其中。当他的唇覆上她的，彼此间的激情升温时，他发现一种巨大的满足感来源于让她暂时忘却那份悲伤，哪怕只有片刻。”~
@85 = ~“她从未像那时那样美丽过。餍足而近乎入睡，她的嘴唇向上弯起，那是只为他绽放的微笑。她的手指伸来触摸他的肌肤，慵懒地描画着图案，睡意朦胧地铭记着他的轮廓。他们低声交谈了数小时，漫谈着无意义的琐事与胡话。当睡意最终俘获她时，他才对着夜晚无情的寂静，吐露了他的爱意。”~
@86 = ~“我的渡鸦真是个顽劣的家伙！哦，她是多么喜欢用她狡黠的微笑和摇曳的腰肢来折磨我这个可怜的吟游诗人！我发现自己竟渴望遭遇一场伏击，好把我从想把这女人按在地上、当众尽情蹂躏的念头中分散开来！”~
@87 = ~“她喘息着我的名字，那是一个充满炙热渴望的祈祷词，包裹在那三个简单的音节里，每次都能让我彻底沦陷。她甚至意识到她对我拥有多大的掌控力吗？”~
@88 = ~“我在想，我的渡鸦对杀戮者的控制是否比我之前认为的更脆弱。她昨晚激情中留在我背上的痕迹，看起来可不像是普通的指甲抓痕……”~
@89 = ~“她裸睡。也许她不希望我把这事告诉全世界？啊，好吧。”~
@90 = ~“我在想，我是否应该用整个章节来记述我们在被困幽暗地域时的私密趣事？这肯定会让原本不感兴趣的人关注我渡鸦的生活。而且这只麻雀也无法假装他不喜欢重温这些回忆……”~
@91 = ~“她昨晚穿了那件同样褪色破旧的束腰外衣。这女人根本不知道，每次她在座位上挪动时，瞥见那些诱人肌肤的瞬间是多么让人抓狂！如果旅店没那么拥挤，我很可能会非常公开地向她展示，我是多么渴望看到那件外衣被揉皱在地板上。”~
@92 = ~“我怎么知道我爱我的<CHARNAME>？昨晚在激情的巅峰，这女人差点从我头上扯下一把头发，而我却并不因此怨恨她。如果这都不是真爱，那我就不知道什么是了。”~
@93 = ~“我不知道如何表达此刻充满我的那种感觉……是力量？是兴奋？是爱慕？无论它是什么。看着我美丽的<CHARNAME>，这位以其言行震撼多元宇宙的、强大的半神，跪倒在我这个吟游诗人面前，取悦我直到我喘息着释放……我不知该如何用言语充分形容这种感觉。但我确实知道，我绝不会用这经历去交换卡尼亚所有的雪。”~
@94 = ~“我的渡鸦会说梦话。但这些低语并非我通常从爱人那里听到的内容。我并不羞于承认她的话让我害怕。我，一个会欢快地歌唱她那无人见过的胎记的吟游诗人，一个会亲密细致地询问她变成杀戮者时感受的吟游诗人，永远不会将她午夜萦绕的低语诉诸纸上。这些东西最好被熵吞噬，被遗忘。”~
@95 = ~“令我欣喜的是，我发现我的渡鸦怕痒。不幸的是，她很快也发现了我同样怕痒。昨晚远不如我最初希望的那样‘令人满足’。恐怕我们得把彼此的手绑在背后，才能再获得一次像样的休息了。”~
@96 = ~“那天早晨她触摸中的急迫感，并未被与她同床共枕的男子忽视。无论前夜何种噩梦萦绕着她，都种下了一颗恐惧的腐坏种子，在黎明苍白的微光中盛放成花。他的吻以安全的承诺抚慰着她，他的手以他存在的温暖保证安抚着她，但这还不够。”~
@97 = ~“当她无声地恳求他靠近、与她身体交融、以最原始的方式提醒她在这生命中仍有欢愉可寻时，他再次意识到，尽管他富有才华和巧言，却无法将她从血脉中的噩梦里拯救出来。”~
@98 = ~“他注视着她懒散地浏览商贩的货摊。她似乎对他的凝视浑然不觉，或许她是出于自己的理由而忽略了他。无论哪种情况，他利用这份自由，公然观察着她，目光从她的下颌线游移到她喉部裸露的肌肤。他发现自己很想知道，她是否明白他多么渴望品尝那里的皮肤，用舌头滑过她的锁骨，轻轻咬上她肩膀的轮廓。”~
@99 = ~“她那一刻可能并未察觉他的想法，但他会确保在最近的旅店里让她知道。”~
@100 = ~“浴室里空无一人，这真是天赐之福，他们跌跌撞撞地冲进门，背包、护甲碎片和衣物从他们沾满血迹与灰尘的身体上飞散，他们挣扎着将彼此从日常的束缚中解放出来。她的嘴先找到他的，啃咬、索取、充满侵略性，以他喜爱却不曾明说的所有方式。”~
@101 = ~“她锋利的牙齿狠狠咬住他的嘴唇，让他尝到了铜锈味，作为报复，他把她向后推入微温的浴桶中，在她呛水挣扎起身、甩掉剩余衣物时大笑。当他被她从膝盖后面一绊，滑倒在那个湿滑、大笑的女人身上时，他的欢愉戛然而止。感受着她湿润、炙热的胴体在他身下扭动，足以终结他们粗野的前戏。”~
@102 = ~“他的嘴用力吸吮着她的脖颈，手掌抚过她的背脊，他开始充分利用他们在浴室中独处的时光。”~
@103 = ~“那些日子里，星空下的片刻偷欢是他们所能希冀的一切——衣物摩擦的轻柔低语、肌肤抵在无情树皮上的粗砺摩擦、紧贴在一起以吞没彼此压抑欢愉呻吟的双唇。这类难得的现实逃离最好情况下也是危险的，因为他们极有可能被猝不及防地抓住并瞬间丧命，但这是可以接受的风险。”~
@104 = ~“他们对彼此的激情与渴望，提醒着他们为何要继续战斗，即使整个多元宇宙都起来要将他们吞噬。”~
@105 = ~“他们的释然显而易见，他们的喜悦难以言表。他们做爱直至深夜，又在晨光初现时再度缠绵。事后，她把头枕在他胸前，将腿蜷搭在他身上，手指慵懒地抚摸着他髋部的敏感肌肤。他的手沿着她的脊背游走，呼吸着所爱之人的气息，生平第一次，仅仅片刻，他理解了‘知足’的吸引力。”~
@106 = ~（一张不比你手掌大的方形小羊皮纸从书页间滑落。纸上，你发现了一幅你的画像。可能是在你睡觉时画的，因为你的眼睛闭着，表情安详。你面部的细节，尤其是嘴唇和眼睛，以精致、逼真的笔触再现。）~
@107 = ~（几片干枯的叶子从书页间滑落，散在你脚边。）~
@108 = ~（一大张折叠的羊皮纸从书中滑出。展开后，你发现一幅精细描绘的图画，上面是海尔达利骑着一头巨大的龙。他的头发在风中飘扬，嘴张大作胜利的咆哮，双剑高举作戏剧性的姿态。这巨兽背上甚至还有一副鞍具。）~
@109 = ~（慢慢翻阅书籍时，你发现一朵脆弱、干枯的花被压在两页之间。然而，这不是普通的花。正是海尔达利在某次难忘的场合，缠绕在你背包带子上的那同一朵花。）~
@110 = ~（你在书中发现一张便条。）~
@111 = ~“主位面的星辰真是奇妙之物。我曾多次思索它们的意义。它们是灵魂吗？是被放逐到遥远天空为罪行受苦的受折磨灵魂吗？它们是窥视其他位面与现实的窗口吗？”~
@112 = ~“奇怪的是，我发现我无法长久沉浸于这些思考。当我脑海中转过这些念头片刻之后，我便不再关心它们的含义了。这些闪烁的光芒让我分神，直到我只能想一件事：星辰很美。”~
@113 = ~“或许，这就足够了。”~
@114 = ~“或许我应该试试。又能有什么坏处呢？很多，唉，是的。但即将到来的死亡或肢解威胁，何时曾阻止过我？”~
@115 = ~“昨天是我的生日。又发现了两根白头发。”~
@116 = ~“- 2颗红宝石
- 6颗钻石
- 103枚金币
- 香薰油
- 蜡烛
- 丝绸
- 7条鳕鱼”~
@117 = ~“给自己提个醒：永远不要走海路。任何地方。永远。”~
@118 = ~“烛光下的她的眼眸
她初醒时的微笑
她受冤屈时的愤怒
她贴在我唇上的双唇
我多么爱她的所有激情”~
@119 = ~“空气中弥漫着恐惧。<CHARNAME>在睡梦中哭喊、辗转。我们正踏着一条由鲜血与痛苦铺就的陌生之路。我希望我能活着看到它通向何方。”~
@120 = ~“趁她熟睡时，我离开了。收拾起我微薄的行李，没留一句告别的话就走出了旅店。”~
@121 = ~“走了不到一百步，我转身回去了。她睡着时看起来如此不同。安详。她知道我总有一天会离开并不再回来。但那天不是今天。”~
@122 = ~“主位面带来奇怪的梦。昨晚，我在一桶融化的奶酪里游泳。前晚，月亮活了过来，向我诉说了它的秘密。它们无聊得令人失望。再往前几晚，<CHARNAME>勒死了我，复活了我的尸体，并命令我别再在公共场合穿她的内衣。我不禁在想，一位先知会从这些景象中发现什么含义。”~
@123 = ~（一张散页落入你手中。整张羊皮纸，从正面到背面，从上到下，布满了毫无意义的涂鸦。星辰、爱心、藤蔓、花朵、奇怪的符号，以及难以想象的各种潦草线条、涂鸦和划痕，共同构成了一幅令人眼花缭乱的景象。）~
@124 = ~（翻阅书籍时，你发现一张散页，上面画着一幅非常精确的烛堡素描。）~
@125 = ~（有东西从书页间掉落。当你弯腰拾起时，发现那是一小缕蓝色的头发，用一根细皮绳整齐地绑着。）~
@126 = ~（一把小巧、装饰华丽的钥匙从书中掉出，在你脚边哐当作响。）~
@127 = ~（你发现一片彩色碎布，上面绣着一个奇怪的符号，夹在两页之间。）~
@128 = ~（你发现一张剧院票根从书中伸出。上面写着阿斯卡特拉的五酒壶旅店地下剧场，主演是海尔达利，扮演罗德里戈一角。）~
@129 = ~（你没有发现任何感兴趣的东西。）~
@130 = ~（海尔达利，你心爱的麻雀，为你创作这本书倾注了无数光阴。你真的要毁掉它吗？）~
@131 = ~是的。~
@132 = ~不。~
@133 = ~（事情做完了。）~
@134 = ~（海尔达利，你的朋友与伙伴，为你创作这本书倾注了无数光阴。你真的要毁掉它吗？）~